# Dependencies and their store: the plugin's workspace keeps its store inside
# the project (.pnpm-store), so both are local artifacts rather than sources.
node_modules/
.pnpm-store/

# Measurement output from scripts/*.mjs (frames, logs, JSON), regenerated by
# running the scripts rather than read from the repository.
.prove/

# The built bundle is committed (lib/), so that a GitHub install needs no build
# step. Its source maps are part of that bundle and are committed with it.
